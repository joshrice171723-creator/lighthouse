{
  "name": "lighthouse",
  "version": "0.2.0",
  "private": true,
  "description": "Lighthouse partner and participant portal powered by North Star.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "vite --host 127.0.0.1 --strictPort --port 5175",
    "build": "vite build",
    "test": "node --test test/*.test.cjs",
    "lighthouse:server": "node scripts/lighthouse-server.cjs",
    "lighthouse:rails": "bundle exec rails db:prepare && bundle exec rails server -b 127.0.0.1 -p 3000",
    "next-step:dev": "concurrently -k -s first \"npm run start\" \"npm run lighthouse:server\" \"bundle exec rails -C backend db:prepare && bundle exec rails -C backend server -b 127.0.0.1 -p 3000\"",
    "lighthouse:dev": "cross-env LIGHTHOUSE_DEV_MODE=1 node scripts/lighthouse-server.cjs",
    "desktop": "concurrently -k -s first \"npm run start\" \"wait-on http://127.0.0.1:5174 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 electron .\"",
    "desktop:north-star": "concurrently -k -s first \"npm run start\" \"wait-on http://127.0.0.1:5174 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 electron .\"",
    "desktop:prod": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win nsis portable",
    "package:win:installer": "npm run build && electron-builder --win nsis",
    "package:win:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@langchain/core": "^1.2.8",
    "@langchain/langgraph": "^1.4.10",
    "@langchain/openai": "^1.5.8",
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "^13.0.3",
    "country-state-city": "^3.2.1",
    "drizzle-orm": "^0.45.2",
    "langsmith": "^0.8.11",
    "lucide-react": "latest",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "playwright": "^1.62.1",
    "wait-on": "latest",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.northstar.career",
    "productName": "North Star",
    "asar": true,
    "files": ["dist/**/*", "electron/**/*", "package.json", "norht_Star_icon.png", "north_Star_logo.png"],
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "norht_Star_icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "North Star"
    },
    "portable": {
      "artifactName": "North-Star-Portable-${version}.${ext}"
    },
    "artifactName": "North-Star-Setup-${version}.${ext}"
  }
}
